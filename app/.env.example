# Oracle AI Database (the agent harness)
ORA_DSN=localhost:1521/FREEPDB1
ORA_AGENT_USER=AGENT
ORA_AGENT_PWD=AgentPw_2026
# Chat model — OCI Generative AI via its OpenAI-compatible endpoint (the only outbound call).
LLM_PROVIDER=oci
OCI_GENAI_API_KEY=...
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com/openai/v1
LLM_MODEL=xai.grok-4.20-non-reasoning
# Layer 8 context engineering: a deliberately small teaching budget, how many recent turns travel
# as messages, and the size above which a tool result is offloaded to the vector archive.
TR_CONTEXT_BUDGET=8000
TR_HISTORY_MESSAGES=6
TR_OFFLOAD_CHARS=2400
